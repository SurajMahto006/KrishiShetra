# ─────────────────────────────────────────────────────────
# KrishiShetra AI Quality Service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Absolute or relative path to the trained YOLOv8 weights file.
# The file must exist before the service will report modelLoaded=true.
# After training, set this to e.g.: outputs/vegqual-20ep/weights/best.pt
MODEL_PATH=outputs/vegqual-20ep/weights/best.pt

# Human-readable version string returned in every API response.
MODEL_VERSION=vegqual-20ep

# Maximum allowed upload size in megabytes.
MAX_UPLOAD_MB=10

# Minimum image dimension (width and height) in pixels.
MIN_IMAGE_DIM=64

# Directory used for temporary image files during inference.
# Files are deleted immediately after inference completes.
TEMP_DIR=tmp

# Port the FastAPI service listens on.
PORT=8001

# YOLO inference confidence threshold (0.0 – 1.0).
# Detections below this threshold are discarded.
CONF_THRESHOLD=0.25

# YOLO inference IoU threshold for NMS.
IOU_THRESHOLD=0.45

# YOLO inference image size in pixels.
# Must match the imgsz used during training (vegqual-20ep was trained at imgsz=320).
IMGSZ=320
