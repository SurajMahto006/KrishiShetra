NODE_ENV=production
PORT=10000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# Brevo Transactional Email Delivery
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=your_verified_sender@example.com
EMAIL_FROM_NAME=KrishiShetra

# Production Frontend Origin (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-domain.com

# Official Government of India Mandi Data (data.gov.in)
# Register at https://data.gov.in to obtain an API key for live daily Agmarknet mandi prices
DATA_GOV_API_KEY=your_data_gov_in_api_key
